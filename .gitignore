# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Jupyter Notebooks
# ==============================================================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ==============================================================================
# Operating System & IDE Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ==============================================================================
# Large Datasets, Databases & Training Tensors (Exceed GitHub 100MB limit)
# ==============================================================================
*.db
*.sqlite
*.sqlite3
*.feather
*.parquet
*.csv.gz
*.tar.gz

# Statcast SQLite database
data/mlb.db
notebooks/data/

# Raw and training data
data/raw_data/*
data/training/*

# Preserve empty directory structures and tracked leaderboards
!data/raw_data/.gitkeep
!data/training/.gitkeep
!data/models/.gitkeep
!analysis/scratch/.gitkeep
!data/leaderboards/*.csv

# ==============================================================================
# Logs & Scratch
# ==============================================================================
*.log
logs/
analysis/scratch/*
!analysis/scratch/.gitkeep
scratch/
